{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi agent",
  "version": "0.1.0",
  "identifier": "com.locafra.pi-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pi agent",
        "width": 1100,
        "height": 720,
        "minWidth": 560,
        "minHeight": 380
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "pi coding agent in una finestra desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NEYxODI0RUEwNEVBRUMKUldUczZnVHFKQmhQOWxTWE94UVVaQkt0NzB1R2RidWhFZS95NmtVYkl5M3c3SXJ1Vmw4SEhNczEK",
      "endpoints": [
        "https://github.com/locafra/pi-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
